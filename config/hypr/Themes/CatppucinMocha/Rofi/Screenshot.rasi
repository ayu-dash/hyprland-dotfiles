@import "Base.rasi"

configuration {
    show-icons: false;
}

window {
    margin: 10px;
    transparency: "real";
    location: southwest;
    anchor: west;
    width: 80px;
    padding: 2px;
    background-color: @crust;
    border: 1px solid;
    border-color: #cba6f7;
    border-radius: 8px;
}

mainbox {
    enabled: true;
    padding: 6px;
    background-color: @crust;
    children: [ "listview" ];
    border: 0px solid;
}

listview {
    enabled: true;
    columns: 1;
    lines: 3;
    cycle: true;
    scrollbar: false;
    layout: vertical;
    spacing: 8px;
    background-color: transparent;
    cursor: "default";
}

element {
    enabled: true;
    padding: 10px;
    background-color: #181825;
    text-color: #cdd6f4;
    cursor: pointer;
    border-radius: 8px;
}

element-text {
    font: "JetbrainsMono NF Bold 14";
    background-color: transparent;
    text-color: inherit;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

element normal.normal,
element alternate.normal {
    background-color: #181825;
    text-color: #cdd6f4;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: #313244;
    text-color: #f5c2e7;
    border: 1px solid;
    border-color: #cba6f7;
}
